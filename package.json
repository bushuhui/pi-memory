{
  "name": "pi-memeory",
  "version": "1.2.0",
  "description": "OpenClaw enhanced LanceDB memory plugin with hybrid retrieval (Vector + BM25), cross-encoder rerank, multi-scope isolation, management CLI, and standalone HTTP/MCP server",
  "type": "module",
  "main": "index.ts",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "memory",
    "lancedb",
    "vector-search",
    "bm25",
    "hybrid-retrieval",
    "rerank",
    "ai-memory",
    "long-term-memory",
    "mcp",
    "http-server"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/bushuhui/memory-lancedb-pro.git"
  },
  "author": "bushuhui",
  "license": "MIT",
  "dependencies": {
    "@lancedb/lancedb": "^0.26.2",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@sinclair/typebox": "0.34.48",
    "openai": "^6.21.0"
  },
  "bin": {
    "pi-memory-server": "./scripts/pi-memory-server.ts",
    "index-knowledge": "./scripts/index-knowledge.mjs"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node test/cli-smoke.mjs",
    "server": "node --import jiti/register scripts/pi-memory-server.ts"
  },
  "devDependencies": {
    "commander": "^14.0.0",
    "jiti": "^2.6.0",
    "typescript": "^5.9.3"
  }
}
